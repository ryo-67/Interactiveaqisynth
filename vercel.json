{
  "framework": "vite",
  "outputDirectory": "build",
  "functions": {
    "api/aqi/historical.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(scene|scene-test)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/scene-test",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
